{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-forge:workflow:1.0.0",
  "title": "Agent Forge Workflow",
  "description": "Portable graph format exported by Agent Forge.",
  "type": "object",
  "required": ["schema_version", "name", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "runtime": {
      "type": "object",
      "properties": {
        "mode": { "const": "local" },
        "preview": { "const": "mock" }
      },
      "required": ["mode", "preview"],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "position"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["agent", "tool", "condition", "human", "parallel", "output"] },
          "name": { "type": "string", "minLength": 1 },
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            },
            "additionalProperties": false
          },
          "instructions": { "type": "string" },
          "model": { "type": "string" },
          "temperature": { "type": ["number", "string"] },
          "tool": { "type": "string" },
          "description": { "type": "string" },
          "input": { "type": "string" },
          "expression": { "type": "string" },
          "prompt": { "type": "string" },
          "required": { "type": "boolean" },
          "branches": { "type": ["integer", "string"] },
          "output": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "label": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
